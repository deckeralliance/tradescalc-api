# TradesCalc API Environment Configuration
# Copy to .env and fill in values

# Environment: development | production
TRADESCALC_ENV=development

# RapidAPI proxy secret (get from RapidAPI Studio > Hub Listing > Gateway)
RAPIDAPI_PROXY_SECRET=

# API key salt for direct customers (generate a random string)
TRADESCALC_API_KEY_SALT=change-me-to-random-string
